# Backend origin (without the /api/v1 path prefix) used by the Next.js dev proxy.
API_PROXY_TARGET=https://alpa.io.vn

# Public API base URL used by production builds/server-side requests.
NEXT_PUBLIC_API_BASE_URL=https://alpa.io.vn/api/v1

# SignalR notification hub (the backend exposes this at /hubs/notification).
NEXT_PUBLIC_SIGNALR_URL=https://alpa.io.vn/hubs/notification
