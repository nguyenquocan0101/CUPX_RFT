# Copy this file to .env and replace all example values before deployment.

# Cloudflare Tunnel connector token from Zero Trust > Networking > Tunnels.
TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# Public URLs (no trailing slash).
PUBLIC_API_URL=https://api.example.com
WEBAPP_DOMAIN=https://app.example.com

# Runtime.
ASPNETCORE_ENVIRONMENT=Production
API_HOST_PORT=30475
SQLSERVER_HOST_PORT=11433
MSSQL_SA_PASSWORD=replace_with_a_strong_database_password
JWT_KEY=replace_with_at_least_32_random_characters
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace_with_supabase_service_role_key

# VNPay sandbox credentials (register at https://sandbox.vnpayment.vn/devreg/)
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

RABBITMQ_USERNAME=replace_with_rabbitmq_username
RABBITMQ_PASSWORD=replace_with_a_strong_rabbitmq_password
RABBITMQ_MANAGEMENT_PORT=15672
